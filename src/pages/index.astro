---
import '../styles/global.css';
import '@fontsource/anton';
import '@fontsource-variable/mona-sans';
import '@fontsource/monaspace-neon';
import portfolio from '../data/portfolio.json';

const assets = import.meta.glob<string>('../assets/fetched/**/*.{webp,png,jpg,jpeg}', {
  eager: true,
  import: 'default',
  query: '?url',
});

const assetUrl = (file: string | null | undefined) => file ? assets[`../${file.replace(/^src\//, '')}`] ?? null : null;
const { profile, links, projects, calendar, badges } = portfolio;
type Project = (typeof projects)[number];
const ownerAvatars: Record<string, { file: string } | undefined> = portfolio.ownerAvatars;
const contactUrl = links.find((link) => link.label === 'LinkedIn')?.url ?? `https://github.com/${profile.login}`;
const run = projects.filter((project): project is Project & { run: number } => Boolean(project.run)).sort((a, b) => a.run - b.run);
const communityProjects = projects.filter((project) => project.source === 'community');
const compactDate = (date: string) => new Date(date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const displayDate = (date: string) => new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const monthLabels = calendar.days.flatMap((day, index, days) => {
  const date = new Date(`${day.date}T00:00:00Z`);
  const previous = index ? new Date(`${days[index - 1].date}T00:00:00Z`) : null;
  return !previous || date.getUTCMonth() !== previous.getUTCMonth()
    ? [{ label: date.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }), column: Math.floor(index / 7) }]
    : [];
});
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const printShape = (project: Project, index: number) => {
  type Shape = 'circle' | 'triangle' | 'square' | 'quarter' | 'half' | 'bar' | 'chevron' | 'hex' | 'diamond' | 'ring';
  const shapeByLanguage: Partial<Record<string, Shape>> = {
    Go: 'circle', Python: 'triangle', TypeScript: 'square', JavaScript: 'quarter',
    HTML: 'half', CSS: 'bar', SCSS: 'bar', Shell: 'chevron', Bicep: 'hex',
    HCL: 'hex', 'C#': 'diamond', Jupyter: 'ring',
  };
  const inks = ['#1e4fff', '#ff3ea5', '#ffd22a'];
  const seed = [...project.name].reduce((sum, character) => sum + character.charCodeAt(0), index * 31);
  const shapes = (project.languages ?? []).slice(0, 3).map((language, shapeIndex) => {
    const shape = shapeByLanguage[language.name] ?? 'pill';
    const x = 26 + ((seed + shapeIndex * 47) % 178);
    const y = 28 + ((seed * (shapeIndex + 3) + 17) % 120);
    const color = inks[shapeIndex];
    const size = 25 + Math.round(42 * Math.sqrt(language.share ?? 0.1));
    const markup = {
      circle: `<circle cx="${x}" cy="${y}" r="${size / 2}"/>`,
      triangle: `<path d="M${x} ${y - size / 2} L${x + size / 2} ${y + size / 2} H${x - size / 2} Z"/>`,
      square: `<rect x="${x - size / 2}" y="${y - size / 2}" width="${size}" height="${size}"/>`,
      quarter: `<path d="M${x} ${y} V${y - size} A${size} ${size} 0 0 1 ${x + size} ${y} Z"/>`,
      half: `<path d="M${x - size / 2} ${y} A${size / 2} ${size / 2} 0 0 1 ${x + size / 2} ${y} V${y + 3} H${x - size / 2} Z"/>`,
      bar: `<rect x="${x - size / 2}" y="${y - 5}" width="${size}" height="10"/>`,
      chevron: `<path d="M${x - size / 2} ${y - size / 2} L${x} ${y} L${x - size / 2} ${y + size / 2} H${x} L${x + size / 2} ${y} L${x} ${y - size / 2} Z"/>`,
      hex: `<path d="M${x - size / 2} ${y} L${x - size / 4} ${y - size / 2} H${x + size / 4} L${x + size / 2} ${y} L${x + size / 4} ${y + size / 2} H${x - size / 4} Z"/>`,
      diamond: `<path d="M${x} ${y - size / 2} L${x + size / 2} ${y} L${x} ${y + size / 2} L${x - size / 2} ${y} Z"/>`,
      ring: `<circle cx="${x}" cy="${y}" r="${size / 2}" fill="none" stroke-width="8"/>`,
      pill: `<rect x="${x - size / 2}" y="${y - 11}" width="${size}" height="22" rx="11"/>`,
    }[shape];
    return `<g fill="${color}" class="print-ink ink-${shapeIndex}">${markup}</g>`;
  }).join('');
  return `<svg viewBox="0 0 230 180" aria-hidden="true" focusable="false"><path class="registration" d="M8 16h12M14 10v12M210 164h12M216 158v12"/>${shapes}</svg>`;
};
const runItems = run.map((project) => ({
  title: project.title,
  name: project.name,
  url: project.url,
  homepage: project.homepage,
  description: project.description || project.summary || project.subtitle || 'A public project from GitHub.',
  language: project.primaryLanguage || 'Repository',
  pushed: compactDate(project.pushedAt),
  image: assetUrl(project.image?.file),
  alt: project.image?.alt || project.title,
}));
const contributionByWeek = Array.from({ length: Math.ceil(calendar.days.length / 7) }, (_, weekIndex) =>
  calendar.days.slice(weekIndex * 7, weekIndex * 7 + 7));
const initialProject = run[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf5ea" />
    <meta name="description" content={`${profile.name}'s living portfolio of websites, community work and experiments, updated from GitHub.`} />
    <title>{profile.name} — websites and projects</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- THESIS: The work leads: a living portfolio of websites, not a generic card grid.
    OWN-WORLD: Warm paper, blue/pink/yellow/black spot colors, offset rules and grain define the visual style.
    STORY: Visitors scan featured websites, follow real source or live links, then explore contribution history, community work and credentials.
    FIRST VIEWPORT: Name and compact navigation sit above a featured website; a receding project rail and its previous/next controls share the same sightline.
    FORM: risograph-web-system, challenger on re-roll 1; spatial-navigation-enfilade-sightline staging; seed 870e8f20. -->

    <div class="paper-grain" aria-hidden="true"></div>
    <header class="masthead page-wrap">
      <a class="wordmark" href="#top" aria-label="Jürgen Etzlstorfer, home">J.E<span>.</span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#featured-websites">Featured</a>
        <a href="#year">Year in review</a>
        <a href="#community">Community</a>
      </nav>
      <a class="masthead-link" href={`https://github.com/${profile.login}`} target="_blank" rel="noreferrer" aria-label="GitHub">
        <span class="status-dot" aria-hidden="true"></span><span class="masthead-label">GitHub</span><span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="top">
      <section class="opening page-wrap" aria-labelledby="page-title">
        <div class="opening-copy">
          <div class="opening-name" aria-label={profile.name}>
            <span class="ink-title" data-text="JÜRGEN">JÜRGEN</span>
            <span class="ink-title ink-title-small" data-text="ETZLSTORFER">ETZLSTORFER</span>
          </div>
          <div class="opening-meta">
            <div>
              <h1 id="page-title">Projects, an overview.</h1>
              <p>{profile.tagline}</p>
            </div>
            <p class="print-note"><span class="registration-mark" aria-hidden="true">✳</span> A living portfolio, updated from public GitHub data.</p>
          </div>
        </div>

        <section class="sightline" aria-labelledby="sightline-title" data-sightline>
          <div class="section-topline">
            <h2 id="featured-websites">Featured projects</h2>
            <span class="mono run-counter" data-run-count>{String(1).padStart(2, '0')} / {String(run.length).padStart(2, '0')}</span>
            <div class="run-controls" aria-label="Featured project controls">
              <button type="button" class="arrow-button" data-run-prev aria-label="Previous featured project">←</button>
              <button type="button" class="arrow-button" data-run-next aria-label="Next featured project">→</button>
              <span class="mono">Use ← →</span>
            </div>
          </div>
          <div class="run-stage">
            <div class="front-print" data-run-front>
              <div class="front-art" data-run-art>
                <div class="front-geometry" aria-hidden="true" set:html={initialProject ? printShape(initialProject, 0) : ''}></div>
                {initialProject?.image && <img class="front-screenshot" data-run-image src={assetUrl(initialProject.image.file)} alt={initialProject.image.alt || initialProject.title} />}
                <div class="front-print-caption">
                  <span class="front-language mono" data-run-language>{initialProject?.primaryLanguage || 'Repository'}</span>
                  <span class="front-pushed mono" data-run-pushed>{initialProject ? compactDate(initialProject.pushedAt) : ''}</span>
                </div>
              </div>
              <div class="front-info">
                <div class="front-title-row">
                  <span class="run-index mono" data-run-index>PROJECT 01</span>
                  <span class="pinned-stamp" data-run-pinned hidden={!initialProject?.pinned}>PINNED</span>
                </div>
                <h3 class="ink-title front-title" data-text={initialProject?.title || ''} data-run-title>{initialProject?.title}</h3>
                <p class="front-description" data-run-description>{initialProject?.description || initialProject?.summary || initialProject?.subtitle}</p>
                <div class="front-actions">
                  <a class="ink-button" data-run-source href={initialProject?.url} target="_blank" rel="noreferrer">Open source <span aria-hidden="true">↗</span></a>
                  <a class="outline-button" data-run-live href={initialProject?.homepage || '#'} target="_blank" rel="noreferrer" hidden={!initialProject?.homepage}>Live site <span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </div>
            <div class="run-side">
              <p class="side-label">Along the line <span aria-hidden="true">→</span></p>
              <div class="run-rail" role="list" aria-label="Featured projects">
                {run.map((project, index) => (
                  <button
                    class:list={['run-tile', { 'is-active': index === 0 }]}
                    type="button"
                    role="listitem"
                    aria-current={index === 0 ? 'true' : undefined}
                    aria-label={`Show ${project.title}`}
                    data-run-select
                    data-index={index}
                    data-title={project.title}
                    data-name={project.name}
                    data-url={project.url}
                    data-homepage={project.homepage || ''}
                    data-description={project.description || project.summary || project.subtitle || 'A public project from GitHub.'}
                    data-language={project.primaryLanguage || 'Repository'}
                    data-pushed={compactDate(project.pushedAt)}
                    data-image={assetUrl(project.image?.file) || ''}
                    data-alt={project.image?.alt || project.title}
                    data-pinned={project.pinned ? 'true' : 'false'}
                  >
                    <span class="tile-art" set:html={printShape(project, index)}></span>
                    <span class="tile-title">{project.title}</span>
                    <span class="tile-meta mono">{project.primaryLanguage || 'repo'} · {String(index + 1).padStart(2, '0')}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </section>

        <div class="data-updated mono">
          <span>Data updated · <time datetime={portfolio.generatedAt}>{compactDate(portfolio.generatedAt)}</time></span>
        </div>
      </section>

      <section class="year-section page-wrap" id="year" aria-labelledby="year-title">
        <div class="year-top">
          <div class="section-heading">
            <div>
              <h2 id="year-title">A year of activity</h2>
              <p>Each mark is a day with public GitHub activity.</p>
            </div>
          </div>
          <div class="year-total"><strong>{calendar.total.toLocaleString('en-GB')}</strong><span>contributions<br />in the last year</span></div>
        </div>
        <div class="calendar-scroll">
          <div class="calendar-months" aria-hidden="true">
            {monthLabels.map((month) => <span style={`--month-column:${month.column}`}>{month.label}</span>)}
          </div>
          <div class="calendar-grid" role="img" aria-label={`${calendar.total.toLocaleString('en-GB')} contributions in the last year`}>
            {contributionByWeek.map((week) => (
              <div class="calendar-week">
                {week.map((day) => {
                  const level = day.count === 0 ? 0 : day.count < 3 ? 1 : day.count < 7 ? 2 : day.count < 12 ? 3 : 4;
                  return <span class:list={['calendar-day', `level-${level}`]} title={`${day.count} contributions on ${displayDate(day.date)}`} aria-hidden="true"></span>;
                })}
              </div>
            ))}
          </div>
        </div>
        <div class="year-bottom">
          <span>LESS <i class="calendar-day level-0"></i><i class="calendar-day level-1"></i><i class="calendar-day level-2"></i><i class="calendar-day level-3"></i><i class="calendar-day level-4"></i> MORE</span>
          <span class="mono">SOURCE · GITHUB CONTRIBUTION CALENDAR</span>
        </div>
      </section>

      <section class="community-section" id="community" aria-labelledby="community-title">
        <div class="community-inner page-wrap">
          <div class="community-heading">
            <h2 id="community-title">Made with<br />other people.</h2>
            <p>Websites and open-source projects are better built together. A few projects and communities Jürgen contributes to.</p>
            <a class="paper-button" href="https://www.meetup.com/cloud-native-linz/" target="_blank" rel="noreferrer">Meet Cloud Native Linz <span aria-hidden="true">↗</span></a>
          </div>
          <div class="community-list">
            {communityProjects.map((project, index) => {
              const avatar = ownerAvatars[project.owner] || ownerAvatars[project.owner.toLowerCase()];
              return (
                <a class="community-row" href={project.homepage || project.url} target="_blank" rel="noreferrer">
                  <span class="community-index mono">{String(index + 1).padStart(2, '0')}</span>
                  {avatar && <img src={assetUrl(avatar.file)} alt="" loading="lazy" />}
                  <span class="community-copy"><strong>{project.owner}</strong><small>{project.title}</small></span>
                  <span class="community-type">{project.primaryLanguage || 'Community'}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="badges-section page-wrap" aria-labelledby="badges-title">
        <div class="section-heading">
          <div>
            <h2 id="badges-title">Proof of practice</h2>
            <p>Credentials and community recognition, from Credly.</p>
          </div>
          <a class="text-link mono" href="https://www.credly.com/users/jetzlstorfer" target="_blank" rel="noreferrer">ALL {badges.length} BADGES ↗</a>
        </div>
        <div class="badge-shelf">
          {badges.map((badge) => (
            <a class="badge-print" href={badge.url} target="_blank" rel="noreferrer" title={`${badge.name} — ${badge.issuer}`}>
              {badge.image && <img src={assetUrl(badge.image.file)} alt="" loading="lazy" />}
              <span>{badge.name}</span>
              <small>{badge.issuer}</small>
            </a>
          ))}
        </div>
      </section>

    </main>

    <footer class="colophon page-wrap">
      <div class="colophon-close">
        <span class="mono">THE NEXT WEBSITE IS ALREADY IN PROGRESS.</span>
        <a class="ink-button" href={contactUrl} target="_blank" rel="noreferrer">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-links">
        <span class="footer-name">{profile.name}</span>
        <div>
          {links.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
        </div>
      </div>
      <div class="colophon-bottom">
        <span>Updated {displayDate(portfolio.generatedAt)} · Data from public GitHub and Credly</span>
        <span class="mono">MADE WITH OPEN SOURCE</span>
        <a href="#top" class="back-to-top">BACK TO TOP ↑</a>
      </div>
    </footer>

    <script define:vars={{ runItems: safeJson(runItems) }}>
      const run = JSON.parse(runItems);
      const stage = document.querySelector('[data-sightline]');
      const buttons = [...stage.querySelectorAll('[data-run-select]')];
      const title = stage.querySelector('[data-run-title]');
      const description = stage.querySelector('[data-run-description]');
      const source = stage.querySelector('[data-run-source]');
      const live = stage.querySelector('[data-run-live]');
      const geometry = stage.querySelector('.front-geometry');
      let image = stage.querySelector('[data-run-image]');
      const language = stage.querySelector('[data-run-language]');
      const pushed = stage.querySelector('[data-run-pushed]');
      const pinned = stage.querySelector('[data-run-pinned]');
      const projectIndex = stage.querySelector('[data-run-index]');
      const counter = stage.querySelector('[data-run-count]');
      let active = 0;

      function selectProject(index, useTransition = true) {
        const next = (index + run.length) % run.length;
        const update = () => {
          active = next;
          const item = run[next];
          geometry.replaceChildren(buttons[next].querySelector('.tile-art svg').cloneNode(true));
          title.textContent = item.title;
          title.dataset.text = item.title;
          description.textContent = item.description;
          source.href = item.url;
          language.textContent = item.language;
          pushed.textContent = item.pushed;
          projectIndex.textContent = `PROJECT ${String(next + 1).padStart(2, '0')}`;
          counter.textContent = `${String(next + 1).padStart(2, '0')} / ${String(run.length).padStart(2, '0')}`;
          pinned.hidden = buttons[next].dataset.pinned !== 'true';
          if (item.homepage) {
            live.href = item.homepage;
            live.hidden = false;
          } else {
            live.hidden = true;
            live.removeAttribute('href');
          }
          if (item.image) {
            if (!image) {
              const nextImage = document.createElement('img');
              nextImage.className = 'front-screenshot';
              nextImage.dataset.runImage = '';
              nextImage.alt = item.alt;
              nextImage.src = item.image;
              geometry.after(nextImage);
              image = nextImage;
            } else {
              image.src = item.image;
              image.alt = item.alt;
              image.hidden = false;
            }
          } else if (image) {
            image.hidden = true;
            image.removeAttribute('src');
          }
          buttons.forEach((button, buttonIndex) => {
            const selected = buttonIndex === next;
            button.classList.toggle('is-active', selected);
            if (selected) button.setAttribute('aria-current', 'true');
            else button.removeAttribute('aria-current');
          });
        };
        if (useTransition && document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.startViewTransition(update);
        } else {
          update();
        }
      }

      buttons.forEach((button) => {
        button.addEventListener('click', () => selectProject(Number(button.dataset.index)));
      });
      stage.querySelector('[data-run-prev]').addEventListener('click', () => selectProject(active - 1));
      stage.querySelector('[data-run-next]').addEventListener('click', () => selectProject(active + 1));
      stage.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          selectProject(active - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          selectProject(active + 1);
        }
      });

    </script>
  </body>
</html>
